# ── Required ─────────────────────────────────────────────────────────────
# Bot tab → Reset Token, at https://discord.com/developers/applications
DISCORD_TOKEN=

# General Information tab → Application ID, same page as above
DISCORD_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────────────────────
# Set this to a single guild ID while developing to register slash commands
# instantly in that server. Leave blank to register commands globally
# (takes up to an hour to propagate, but works in every server the bot joins).
DISCORD_GUILD_ID=

# SQLite is the zero-setup default — no separate database server needed.
# Prisma resolves a relative sqlite path against the prisma/ directory (not
# the project root), so "../data/bot.db" is what actually lands in the
# top-level data/ folder — the Docker Compose file mounts ./data as a
# volume there so this file survives container rebuilds. Don't "simplify"
# this to "./data/bot.db"; that resolves to prisma/data/bot.db instead and
# your data won't survive a rebuild.
# To scale up to Postgres instead, set this to a postgresql:// URL and see
# the "Swapping to Postgres" section in the README.
DATABASE_URL="file:../data/bot.db"

# "Message Content" is a privileged Discord intent. It is only needed for:
#   - the invite-link filter and word/phrase filter (they read message text)
#   - mention-spam detection
#   - legacy "!prefix" commands (opt-in; slash commands never need this)
# Flood/spam-rate detection and every slash command work fine without it.
# To enable: Discord Developer Portal → your app → Bot → Privileged Gateway
# Intents → toggle "Message Content Intent" on, then set this to true.
# Leave it false if you only want slash commands + rate-based spam detection.
ENABLE_MESSAGE_CONTENT=false

# Turns on legacy "!command" style commands in addition to slash commands.
# Requires ENABLE_MESSAGE_CONTENT=true to actually see message text.
ENABLE_PREFIX_COMMANDS=false
PREFIX=!

# debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=production
