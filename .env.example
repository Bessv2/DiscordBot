# ── Required ─────────────────────────────────────────────────────────────
# This is the ONLY line you have to fill in. Everything below already works.
# Get it from https://discord.com/developers/applications → your app →
# Bot tab → Reset Token → Copy. Paste it right after the = sign, with no
# spaces and no quotes. Treat it like a password: never share it.
DISCORD_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────
# Not needed — the bot looks up its own Application ID from the token.
# Safe to leave blank. (Older setups that filled it in keep working.)
DISCORD_CLIENT_ID=

# The bot registers its slash commands by itself every time it starts and
# they've changed. Leave this blank and they work in every server the bot
# joins (the first time, they can take a few minutes to show up).
# Developers: set this to one server's ID to register commands only there,
# instantly. Regular hosts should leave it blank: if you switch between the
# two, the copies registered the other way stay behind, so commands can
# show up twice in that server.
DISCORD_GUILD_ID=

# SQLite is the zero-setup default — no separate database server needed.
# Prisma resolves a relative sqlite path against the prisma/ directory (not
# the project root), so "../data/bot.db" is what actually lands in the
# top-level data/ folder — the Docker Compose file mounts ./data as a
# volume there so this file survives container rebuilds. Don't "simplify"
# this to "./data/bot.db"; that resolves to prisma/data/bot.db instead and
# your data won't survive a rebuild.
# To scale up to Postgres instead, set this to a postgresql:// URL and see
# the "Swapping to Postgres" section in the README.
DATABASE_URL="file:../data/bot.db"

# "Message Content" is a privileged Discord intent. It is only needed for:
#   - the invite-link filter and word/phrase filter (they read message text)
#   - mention-spam detection
#   - legacy "!prefix" commands (opt-in; slash commands never need this)
# Flood/spam-rate detection and every slash command work fine without it.
# To enable: Discord Developer Portal → your app → Bot → Privileged Gateway
# Intents → toggle "Message Content Intent" on, then set this to true.
# Leave it false if you only want slash commands + rate-based spam detection.
ENABLE_MESSAGE_CONTENT=false

# Turns on legacy "!command" style commands in addition to slash commands.
# Requires ENABLE_MESSAGE_CONTENT=true to actually see message text.
ENABLE_PREFIX_COMMANDS=false
PREFIX=!

# "Guild Members" is a privileged Discord intent. It is only needed for:
#   - welcome/goodbye messages (/welcome) — guildMemberAdd/Remove don't
#     fire reliably without it
#   - anti-raid join-rate detection (same reason)
#   - the birthday-role auto-removal cleanup (needs an accurate member
#     cache; the role is still assigned on the day either way)
# To enable: Discord Developer Portal → your app → Bot → Privileged Gateway
# Intents → toggle "Server Members Intent" on, then set this to true.
ENABLE_GUILD_MEMBERS=false

# "Presence" is a privileged Discord intent, needed only for /activityrole
# (auto-assigning a role based on Discord Rich Presence game activity).
# This is the most invasive intent this bot can request — leave it off
# unless you specifically want that feature.
# To enable: same Privileged Gateway Intents page → "Presence Intent".
ENABLE_PRESENCE=false

# ── Music (optional, heavy) ───────────────────────────────────────────────
# /jam needs nothing here: it opens Discord's own YouTube "Watch Together"
# in a voice channel and always works.
# /music has the bot itself join voice and play YouTube songs/playlists.
# It's off by default because:
#   - it uses ~100-200MB more RAM while playing, plus ffmpeg on the CPU
#   - streaming YouTube audio through a bot is against YouTube's Terms of
#     Service. That's on whoever runs the bot, so decide for yourself.
# To turn it on with Docker, set BOTH lines below, then `docker compose up -d`:
#   ENABLE_MUSIC=true
#   BOT_IMAGE_TAG=music      (the image that includes ffmpeg + yt-dlp)
ENABLE_MUSIC=false

# YouTube changes often and breaks old versions of yt-dlp (the tool /music
# uses), so with music on, the bot updates yt-dlp each time it starts. Set
# to false to stop that (music may stop working until you update by hand).
MUSIC_AUTO_UPDATE=true

# ── Docker image & updates ──────────────────────────────────────────────
# Which ready-made image docker-compose.yml downloads:
#   latest = the standard bot   music = the bot plus the /music tools
BOT_IMAGE_TAG=latest

# Automatic updates, OFF by default. Set this to "autoupdate" and run
# `docker compose up -d`: once a day (04:00) it checks for a new version of
# the bot and installs it. Your data is never touched. Leave it empty to
# update yourself with: docker compose pull && docker compose up -d
COMPOSE_PROFILES=

# Time zone for the 04:00 auto-update check, e.g. America/New_York.
TZ=UTC

# ── Web dashboard (optional) ─────────────────────────────────────────────
# A web page for the same settings as /setup: every feature's switch,
# channels, roles and limits, plus the case history. Off by default.
# Admins sign in with a private one-time link from /dashboard in Discord, so
# there are no passwords. It only listens on this computer (127.0.0.1);
# README → "Web dashboard" covers reaching it from elsewhere safely.
# To turn it on with Docker, set these two and run `docker compose up -d`,
# then open http://localhost:3000 via the link /dashboard gives you:
#   ENABLE_DASHBOARD=true
#   DASHBOARD_PORT=3000
ENABLE_DASHBOARD=false
# Port it listens on (default 3000). Pick another if 3000 is taken.
DASHBOARD_PORT=
# Only if you put it behind a reverse proxy or tunnel: the address people
# open, e.g. https://bot.example.com. Sign-in links use it. With https, the
# sign-in cookie is also marked Secure.
DASHBOARD_URL=
# Which address to listen on. Leave blank (this computer only). The Docker
# image already sets what it needs.
DASHBOARD_HOST=

# ── Add-ons ──────────────────────────────────────────────────────────────
# Server admins can add news feeds, Steam news, Epic free games, game-server
# alerts and webhooks (/addons or the dashboard's Add-ons page); nothing to
# set here. Feeds on private or local addresses (your own network) are
# refused, so an admin of some server can't use the bot to look around the
# computer it runs on. Set true only if you trust the admins of every server
# the bot is in, e.g. to read a feed from a reader on your own network.
ADDONS_ALLOW_PRIVATE_NETWORK=false

# ── Optional integrations ───────────────────────────────────────────────
# Every one of these fails closed: the related command/feature just says
# "not configured" instead of crashing when a key below is left blank.

# Powers /streamwatch for Twitch. Create an app at
# https://dev.twitch.tv/console/apps to get a client ID + secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Powers /streamwatch for YouTube. Create a key at
# https://console.cloud.google.com/apis/credentials with the YouTube Data
# API v3 enabled. Note: checking a channel's live status costs 100 of your
# 10,000 daily quota units per check — keep the number of watched YouTube
# channels modest.
YOUTUBE_API_KEY=

# Powers /gamestats steam. Get a key at
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Powers /gamestats lol. Get a key at
# https://developer.riotgames.com (personal keys expire after 24h and are
# fine for testing; apply for a production key for real use).
RIOT_API_KEY=

# debug | info | warn | error
LOG_LEVEL=info

NODE_ENV=production

# Turns off the Prisma database tool's update check and usage ping, so the
# bot never contacts anything but Discord (and integrations you enable).
# Already set inside the Docker image; this line covers running without
# Docker. Leave it at 1. If you ever see an "Update available" box from
# Prisma, ignore it — upgrading Prisma yourself can break the bot.
CHECKPOINT_DISABLE=1
