{
  "name": "discord-mod-bot",
  "version": "1.0.0",
  "description": "A self-hostable Discord moderation and utility bot.",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('fs').cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "node dist/discord/deployCommands.js",
    "deploy-commands:dev": "tsx src/discord/deployCommands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test:e2e": "node tests/e2e/run.cjs",
    "backup": "node dist/scripts/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^5.20.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "gamedig": "^5.3.3",
    "prisma": "^5.20.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/gamedig": "^5.0.3",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "optionalDependencies": {
    "@discordjs/voice": "^0.19.2"
  }
}
